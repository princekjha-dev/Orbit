  sourceType   String   // USER, ORGANIZATION, PROJECT, EVENT, COMMUNITY, STARTUP
  sourceId     String
  targetType   String   // ORGANIZATION, PROJECT, EVENT, COMMUNITY, STARTUP, OPPORTUNITY
  targetId     String
  relationship String   // PARTICIPATED, ORGANIZED, COLLABORATED, EMPLOYED, HOSTED, CONTRIBUTED
  metadata     Json?
  createdAt    DateTime @default(now())

  @@unique([sourceType, sourceId, targetType, targetId, relationship])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}



