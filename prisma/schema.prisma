enum IdentityStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model IdentityVerification {
  id                   String         @id @default(cuid())
  userId               String         @unique
  status               IdentityStatus @default(UNVERIFIED)
  legalName            String
  documentType         String         // GOVERNMENT_ID, PASSPORT, STUDENT_ID, NATIONAL_ID
  documentNumberMasked String         // Masked e.g. "****1234", never raw sensitive number
  verificationUrl      String?        // Secure upload storage
  rejectionReason      String?        @db.Text
  verifiedAt           DateTime?
  reviewedBy           String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum OrgCredentialType {
  DOMAIN_OWNERSHIP
  BUSINESS_REGISTRATION
  OFFICIAL_REPRESENTATIVE
  TAX_IDENTIFIER
}

model OrganizationCredential {
  id             String            @id @default(cuid())
  organizationId String
  type           OrgCredentialType
  issuer         String
  identifier     String            // e.g. domain name, registration number
  documentUrl    String?
  isVerified     Boolean           @default(false)
  verifiedAt     DateTime?
  verifiedBy     String?
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
}

model PortableEvidenceCredential {
  id                String   @id @default(cuid())
  slug              String   @unique
  userId            String
  title             String
  type              String   // PROJECT, INTERNSHIP, WORK, SKILL_EVIDENCE, HACKATHON
  issuerName        String
  issuerOrgId       String?
  recipientName     String
  recipientUsername String
  role              String?
  summary           String   @db.Text
  evidenceUrl       String?
  issuedAt          DateTime @default(now())
  signatureDigest   String   // Cryptographic SHA-256 signature digest
  isRevoked         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([userId])
}

