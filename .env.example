# Orbit Environment Variables
# Copy this to .env.local and fill in your values
# DO NOT COMMIT REAL CREDENTIALS

# ─── Supabase Configuration ──────────────────────────────────────────────────
# Public variables for browser-side SDK
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Privileged server-only secret (NEVER prefix with NEXT_PUBLIC_, NEVER expose to client)
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (Transaction Pooler or Direct)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ─── OAuth Providers (Optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Email & Notifications (Optional) ─────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@orbit.app

# ─── AI Provider Configuration (Groq API for Orbit Dots) ─────────────────────
# Server-side only; never prefix with NEXT_PUBLIC_
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=20000
GROQ_MAX_RETRIES=2

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Orbit

